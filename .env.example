# ---- server/.env ----
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/shopqr
JWT_SECRET=long-random-string
GEMINI_API_KEY=your-gemini-key        # https://aistudio.google.com/apikey
ADMIN_CODE=long-secret-code           # unlocks the Admin tab in Account (only you should know it)
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
CLIENT_ORIGIN=http://localhost:3000   # comma-separate multiple origins
# ---- client/.env.local ----
NEXT_PUBLIC_API=http://localhost:4000
